#!/usr/bin/env bash
# SPDX-License-Identifier: CC0-1.0
# Resolve the T1 camera and our virtual output by identity, not video numbering.
set -euo pipefail
[[ $# = 0 || ( $# = 1 && $1 == --check ) ]] || exit 2
export LC_ALL=C
shopt -s nullglob
sources=()
sinks=()
for entry in /sys/class/video4linux/video*; do
  node=/dev/${entry##*/}
  read -r name < "$entry/name"
  if [[ $name == 'FaceTime HD (Omarchy)' ]]; then
    sinks+=("$node")
    continue
  fi
  ancestor=$(readlink -f -- "$entry/device")
  while [[ $ancestor != / && -n $ancestor ]]; do
    if [[ -r $ancestor/idVendor && -r $ancestor/idProduct ]]; then
      read -r vendor < "$ancestor/idVendor"
      read -r product < "$ancestor/idProduct"
      if [[ $vendor == 05ac && $product == 8600 ]] &&
          v4l2-ctl --device "$node" --list-formats 2>/dev/null | grep -q "'H264'"; then
        sources+=("$node")
      fi
      break
    fi
    ancestor=${ancestor%/*}
    [[ -n $ancestor ]] || ancestor=/
  done
done
if (( ${#sources[@]} != 1 || ${#sinks[@]} != 1 )); then
  printf 'Expected one T1 H.264 camera and one FaceTime HD (Omarchy) output; found %d and %d.\n' "${#sources[@]}" "${#sinks[@]}" >&2
  exit 1
fi
if [[ ${1:-} == --check ]]; then
  printf 'Source: %s\nOutput: %s\n' "${sources[0]}" "${sinks[0]}"
  exit 0
fi
exec "$HOME/.local/libexec/t1-camera-relay" "${sources[0]}" "${sinks[0]}"
