+use super::*;
+use crate::workstream::WorkstreamPhase;
+
+fn running_event() -> WorkstreamEvent {
+    WorkstreamEvent {
+        generation: 1,
+        phase: WorkstreamPhase::Running,
+        label: "BUILDING".into(),
+    }
+}
+
+#[test]
+fn workstream_coalesces_events_without_writing_a_frame_owned_by_hardware() {
+    let (renderer, peer) = seqpacket::pair_for_test().expect("synthetic protocol socket pair");
+    let connection = HardwareConnection::new(renderer);
+    let peer = SeqPacketClient::new(peer.as_fd());
+    let mut session = session();
+    session.enable_workstream(false);
+    session.registered = true;
+    session.submit_if_ready(&connection).unwrap();
+    let held_pixels = session.frame.as_mut_slice().to_vec();
+    let mut packet = vec![0; MAX_PACKET_LENGTH];
+    let length = peer.receive(&mut packet).expect("initial frame submission");
+    let request = wire::decode_client(
+        &packet[..length],
+        AncillaryMetadata::default(),
+        Some(dimensions()),
+    )
+    .unwrap();
+    let ClientMessage::SubmitFrame(submit) = request.message else {
+        panic!("expected a frame submission");
+    };
+    session
+        .handle(
+            Envelope {
+                request_id: request.request_id,
+                message: ServiceMessage::Ack,
+            },
+            &connection,
+        )
+        .unwrap();
+
+    session.set_workstream(Some(running_event()), Duration::ZERO);
+    for time in [34, 68, 102] {
+        session
+            .advance(Duration::from_millis(time), &connection, None)
+            .unwrap();
+        assert_eq!(session.frame.as_mut_slice(), held_pixels);
+        assert_eq!(peer.receive(&mut packet), Err(SeqPacketError::WouldBlock));
+    }
+    assert!(session.dirty);
+    session
+        .handle(
+            Envelope {
+                request_id: 0,
+                message: ServiceMessage::FrameReleased(wire::FrameReleased {
+                    buffer_id: BUFFER_ID,
+                    frame_id: submit.frame_id,
+                }),
+            },
+            &connection,
+        )
+        .unwrap();
+    assert_ne!(session.frame.as_mut_slice(), held_pixels);
+    assert!(!session.dirty);
+    let length = peer.receive(&mut packet).expect("one coalesced frame");
+    let request = wire::decode_client(
+        &packet[..length],
+        AncillaryMetadata::default(),
+        Some(dimensions()),
+    )
+    .unwrap();
+    assert!(matches!(request.message, ClientMessage::SubmitFrame(_)));
+    assert_eq!(peer.receive(&mut packet), Err(SeqPacketError::WouldBlock));
+}
+
+#[test]
+fn running_workstream_yields_the_complete_function_row_and_taps() {
+    let mut workstream = session();
+    workstream.enable_workstream(false);
+    workstream.set_workstream(Some(running_event()), Duration::ZERO);
+    workstream
+        .advance(Duration::from_millis(34), &inert_connection(), None)
+        .unwrap();
+    workstream.render().unwrap();
+    let activity_pixels = workstream.frame.as_mut_slice().to_vec();
+    assert!(
+        workstream
+            .observe_input(input(1, true, Vec::new()))
+            .unwrap()
+            .redraw
+    );
+    workstream.render().unwrap();
+    // Fn displays the same Tokyo function row whether activity is running or
+    // idle. The default renderer uses a separate monochrome palette.
+    let mut idle = session();
+    idle.enable_workstream(true);
+    idle.observe_input(input(1, true, Vec::new())).unwrap();
+    idle.render().unwrap();
+    assert_eq!(workstream.frame.as_mut_slice(), idle.frame.as_mut_slice());
+    assert_ne!(workstream.frame.as_mut_slice(), activity_pixels);
+
+    // A settling redraw is allowed at the Fn transition, then activity stops.
+    workstream
+        .advance(Duration::from_millis(68), &inert_connection(), None)
+        .unwrap();
+    workstream.dirty = false;
+    workstream
+        .advance(Duration::from_secs(1), &inert_connection(), None)
+        .unwrap();
+    assert!(!workstream.dirty);
+    workstream
+        .observe_input(input(2, true, vec![contact(1, 15, 8)]))
+        .unwrap();
+    let outcome = workstream
+        .observe_input(input(3, true, Vec::new()))
+        .unwrap();
+    assert_eq!(outcome.actions, [StockAction::Function(FunctionKey::F1)]);
+    workstream
+        .observe_input(input(4, false, Vec::new()))
+        .unwrap();
+    workstream.render().unwrap();
+    assert_ne!(workstream.frame.as_mut_slice(), idle.frame.as_mut_slice());
+}
+
+#[test]
+fn blacking_out_cancels_touch_feedback_before_a_fast_wake() {
+    let mut session = session();
+    session.enable_workstream(false);
+    session.render().unwrap();
+    let idle_pixels = session.frame.as_mut_slice().to_vec();
+    session
+        .observe_input(input(1, false, vec![contact(1, 5, 10)]))
+        .unwrap();
+    session.render().unwrap();
+    assert_ne!(session.frame.as_mut_slice(), idle_pixels);
+    let off = DesktopState {
+        capabilities: DesktopCapabilities::DISPLAY_POWER,
+        display_off: true,
+        ..DesktopState::default()
+    };
+    session.set_desktop_state(off).unwrap();
+    session.render().unwrap();
+    assert!(session.frame.as_mut_slice().iter().all(|byte| *byte == 0));
+
+    // No animation tick between these power notifications: blanking itself
+    // must discard the old glow, rather than relying on the next timer tick.
+    session
+        .set_desktop_state(DesktopState {
+            display_off: false,
+            ..off
+        })
+        .unwrap();
+    session.render().unwrap();
+    assert_eq!(session.frame.as_mut_slice(), idle_pixels);
+    let release = session.observe_input(input(2, false, Vec::new())).unwrap();
+    assert!(release.actions.is_empty());
+}
+
+#[test]
+fn idle_and_hidden_event_changes_do_not_keep_the_session_dirty() {
+    let mut session = session();
+    session.enable_workstream(false);
+    session.render().unwrap();
+    session.dirty = false;
+    session
+        .advance(Duration::from_secs(1), &inert_connection(), None)
+        .unwrap();
+    assert!(!session.dirty);
+
+    session
+        .set_desktop_state(DesktopState {
+            capabilities: DesktopCapabilities::DISPLAY_POWER,
+            display_off: true,
+            ..DesktopState::default()
+        })
+        .unwrap();
+    session.render().unwrap();
+    session.dirty = false;
+    session.set_workstream(Some(running_event()), Duration::from_secs(1));
+    session
+        .advance(Duration::from_secs(2), &inert_connection(), None)
+        .unwrap();
+    assert!(!session.dirty);
+    assert!(session.frame.as_mut_slice().iter().all(|byte| *byte == 0));
+
+    session.set_workstream(None, Duration::from_secs(2));
+    session
+        .advance(Duration::from_secs(3), &inert_connection(), None)
+        .unwrap();
+    assert!(!session.dirty);
+}
