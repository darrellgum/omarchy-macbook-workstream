@@ -0,0 +1,113 @@
+//! Exercise hook delivery through the real sender in isolated runtime storage.
+
+use std::env;
+use std::fs;
+use std::io::Write;
+use std::os::unix::fs::DirBuilderExt;
+use std::path::PathBuf;
+use std::process::{Command, Output, Stdio};
+
+use serde_json::{Value, json};
+use t1_touchbar::workstream::random_generation;
+
+struct Runtime(PathBuf);
+
+impl Runtime {
+    fn new() -> Self {
+        let path = env::temp_dir().join(format!(
+            "t1-workstream-claude-test-{:016x}",
+            random_generation().unwrap()
+        ));
+        fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+        Self(path)
+    }
+
+    fn send(&self, event: &Value) {
+        let output = self.send_bytes(&serde_json::to_vec(event).unwrap());
+        assert!(output.status.success());
+        assert!(output.stdout.is_empty());
+        assert!(output.stderr.is_empty());
+    }
+
+    fn send_bytes(&self, input: &[u8]) -> Output {
+        let mut child = Command::new(env!("CARGO_BIN_EXE_t1-workstream-claude"))
+            .env("XDG_RUNTIME_DIR", &self.0)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        child.stdin.take().unwrap().write_all(input).unwrap();
+        child.wait_with_output().unwrap()
+    }
+
+    fn state(&self) -> String {
+        fs::read_to_string(self.0.join("t1-workstream/state")).unwrap()
+    }
+}
+
+impl Drop for Runtime {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn event(name: &str, session: &str, prompt: &str) -> Value {
+    json!({
+        "hook_event_name": name,
+        "session_id": session,
+        "prompt_id": prompt,
+        "prompt": "SYNTHETIC PRIVATE PROMPT",
+        "last_assistant_message": "SYNTHETIC PRIVATE OUTPUT",
+        "transcript_path": "/synthetic/never-open-this-transcript",
+    })
+}
+
+#[test]
+fn repeated_prompts_restart_and_stale_stops_cannot_finish_new_work() {
+    let runtime = Runtime::new();
+    runtime.send(&event("UserPromptSubmit", "session-a", "prompt-1"));
+    runtime.send(&event("Stop", "session-a", "prompt-1"));
+    assert!(runtime.state().contains("\nattention\nRESPONSE READY\n"));
+    runtime.send(&event("UserPromptSubmit", "session-a", "prompt-2"));
+    let current = runtime.state();
+    assert!(current.contains("\nrunning\nCLAUDE WORKING\n"));
+    runtime.send(&event("Stop", "session-a", "prompt-1"));
+    runtime.send(&event("Stop", "session-b", "prompt-2"));
+    assert_eq!(runtime.state(), current);
+    runtime.send(&event("StopFailure", "session-a", "prompt-2"));
+    let failed = runtime.state();
+    assert!(failed.contains("\nfailed\nCLAUDE ERROR\n"));
+    runtime.send(&event("UserPromptSubmit", "session-a", "prompt-2"));
+    assert_eq!(runtime.state(), failed);
+    assert!(!failed.contains("PRIVATE"));
+    assert!(!failed.contains("session-a"));
+    assert!(!failed.contains("prompt-2"));
+}
+
+#[test]
+fn subagents_and_missing_prompt_identifiers_do_not_modify_main_activity() {
+    let runtime = Runtime::new();
+    runtime.send(&event("UserPromptSubmit", "session-a", "prompt-1"));
+    let current = runtime.state();
+    let mut missing = event("Stop", "session-a", "prompt-1");
+    missing.as_object_mut().unwrap().remove("prompt_id");
+    runtime.send(&missing);
+    let mut subagent = event("Stop", "session-a", "prompt-1");
+    subagent["agent_id"] = json!("synthetic-child");
+    runtime.send(&subagent);
+    assert_eq!(runtime.state(), current);
+}
+
+#[test]
+fn malformed_input_and_unavailable_storage_cannot_fail_claude() {
+    let runtime = Runtime::new();
+    let output = runtime.send_bytes(b"invalid json");
+    assert!(output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(output.stderr.is_empty());
+    assert!(!runtime.0.join("t1-workstream").exists());
+    fs::remove_dir(&runtime.0).unwrap();
+    runtime.send(&event("UserPromptSubmit", "session-a", "prompt-1"));
+    assert!(!runtime.0.exists());
+}
