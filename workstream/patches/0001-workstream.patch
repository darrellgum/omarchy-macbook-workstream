+//! The activity UI must not change the command's output or exit behavior.
+
+use std::env;
+use std::fs;
+use std::os::unix::fs::DirBuilderExt;
+use std::path::PathBuf;
+use std::process::Command;
+
+use t1_touchbar::workstream::random_generation;
+
+struct Runtime(PathBuf);
+
+impl Runtime {
+    fn new() -> Self {
+        let path = env::temp_dir().join(format!(
+            "t1-workstream-cli-test-{:016x}",
+            random_generation().unwrap()
+        ));
+        fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+        Self(path)
+    }
+
+    fn command(&self) -> Command {
+        let mut command = Command::new(env!("CARGO_BIN_EXE_t1-workstream"));
+        command.env("XDG_RUNTIME_DIR", &self.0);
+        command
+    }
+}
+
+impl Drop for Runtime {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn wrapper_preserves_output_and_failure_without_storing_arguments() {
+    let runtime = Runtime::new();
+    let output = runtime
+        .command()
+        .args([
+            "run",
+            "checking",
+            "--",
+            "/bin/sh",
+            "-c",
+            "printf synthetic-private-argument; printf synthetic-stderr >&2; exit 7",
+        ])
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(output.stdout, b"synthetic-private-argument");
+    assert_eq!(output.stderr, b"synthetic-stderr");
+    let state = fs::read_to_string(runtime.0.join("t1-workstream/state")).unwrap();
+    assert!(state.contains("\nfailed\nCHECKING\n"));
+    assert!(!state.contains("synthetic"));
+    assert!(!state.contains("/bin/sh"));
+}
+
+#[test]
+fn missing_runtime_storage_cannot_prevent_successful_command() {
+    let runtime = Runtime::new();
+    let output = runtime
+        .command()
+        .env("XDG_RUNTIME_DIR", runtime.0.join("missing"))
+        .args(["run", "checking", "--", "/bin/sh", "-c", "printf completed"])
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    assert_eq!(output.stdout, b"completed");
+    assert!(output.stderr.is_empty());
+}
+
+#[test]
+fn wrapper_preserves_signal_status_and_does_not_parse_shell_metacharacters() {
+    let runtime = Runtime::new();
+    let output = runtime
+        .command()
+        .args([
+            "run",
+            "checking",
+            "--",
+            "/bin/printf",
+            "%s",
+            "$(synthetic-command); literal",
+        ])
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    assert_eq!(output.stdout, b"$(synthetic-command); literal");
+    let output = runtime
+        .command()
+        .args(["run", "checking", "--", "/bin/sh", "-c", "kill -TERM $$"])
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(143));
+}
+
+#[test]
+fn terminal_hook_labels_cannot_be_replaced_by_a_late_start() {
+    let runtime = Runtime::new();
+    for arguments in [
+        ["begin", "synthetic-operation", "working"],
+        ["attention", "synthetic-operation", "response ready"],
+        ["begin", "synthetic-operation", "working"],
+        ["update", "synthetic-operation", "checking"],
+    ] {
+        assert!(
+            runtime
+                .command()
+                .args(arguments)
+                .status()
+                .unwrap()
+                .success()
+        );
+    }
+    let state = fs::read_to_string(runtime.0.join("t1-workstream/state")).unwrap();
+    assert!(state.contains("\nattention\nRESPONSE READY\n"));
+    assert!(!state.contains("synthetic-operation"));
+}
