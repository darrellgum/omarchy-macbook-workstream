+//! Private, expiring activity hints from explicitly instrumented local work.
+//!
+//! `begin` selects the latest operation. Updates and completions must carry the
+//! same generation, so an older command cannot replace a newer operation. IDs
+//! must be unique per operation, not merely per application session. Only the
+//! supplied display label is stored; command arguments are never recorded.
+
+use std::collections::hash_map::DefaultHasher;
+use std::env;
+use std::fs::{self, File, OpenOptions};
+use std::hash::{Hash, Hasher};
+use std::io::{self, Read, Write};
+use std::os::fd::AsRawFd;
+use std::os::linux::net::SocketAddrExt;
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::os::unix::net::{SocketAddr, UnixDatagram};
+use std::path::{Path, PathBuf};
+use std::thread;
+use std::time::Duration;
+
+const MAX_RECORD_BYTES: u64 = 256;
+const MAX_LABEL_BYTES: usize = 24;
+const O_NONBLOCK: i32 = 0o4_000;
+const O_NOFOLLOW: i32 = 0o400_000;
+const O_PATH: i32 = 0o10_000_000;
+
+/// A truthful activity state; running carries no invented completion percentage.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum WorkstreamPhase {
+    Running,
+    Done,
+    Failed,
+    Attention,
+}
+
+impl WorkstreamPhase {
+    const fn token(self) -> &'static str {
+        match self {
+            Self::Running => "running",
+            Self::Done => "done",
+            Self::Failed => "failed",
+            Self::Attention => "attention",
+        }
+    }
+
+    const fn lifetime_ms(self) -> u64 {
+        match self {
+            Self::Running => 10_000,
+            Self::Done => 3_000,
+            Self::Failed | Self::Attention => 6_000,
+        }
+    }
+
+    fn parse(token: &str) -> Option<Self> {
+        match token {
+            "running" => Some(Self::Running),
+            "done" => Some(Self::Done),
+            "failed" => Some(Self::Failed),
+            "attention" => Some(Self::Attention),
+            _ => None,
+        }
+    }
+}
+
+/// Display data. Heartbeat timestamps are deliberately absent from equality.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct WorkstreamEvent {
+    pub generation: u64,
+    pub phase: WorkstreamPhase,
+    pub label: String,
+}
+
+struct Record {
+    event: WorkstreamEvent,
+    updated_ms: u64,
+}
+
+impl Record {
+    fn parse(bytes: &[u8]) -> Option<Self> {
+        if bytes.len() > usize::try_from(MAX_RECORD_BYTES).ok()? || !bytes.ends_with(b"\n") {
+            return None;
+        }
+        let text = std::str::from_utf8(bytes).ok()?;
+        let fields: Vec<_> = text.lines().collect();
+        if fields.len() != 5 || fields[0] != "t1-workstream-v1" || fields[1].len() != 16 {
+            return None;
+        }
+        let generation = u64::from_str_radix(fields[1], 16).ok()?;
+        let updated_ms = fields[2].parse().ok()?;
+        let phase = WorkstreamPhase::parse(fields[3])?;
+        let label = fields[4];
+        if label.is_empty() || label.len() > MAX_LABEL_BYTES || sanitize_label(label) != label {
+            return None;
+        }
+        Some(Self {
+            event: WorkstreamEvent {
+                generation,
+                phase,
+                label: label.to_owned(),
+            },
+            updated_ms,
+        })
+    }
+
+    fn bytes(&self) -> Vec<u8> {
+        format!(
+            "t1-workstream-v1\n{:016x}\n{}\n{}\n{}\n",
+            self.event.generation,
+            self.updated_ms,
+            self.event.phase.token(),
+            self.event.label,
+        )
+        .into_bytes()
+    }
+
+    fn fresh_at(&self, now_ms: u64) -> bool {
+        now_ms
+            .checked_sub(self.updated_ms)
+            .is_some_and(|age| age < self.event.phase.lifetime_ms())
+    }
+}
+
+/// Reads a bounded private record. Missing, unsafe, malformed, or stale means quiet.
+pub struct WorkstreamReader {
+    directory: PathBuf,
+    uid: u32,
+}
+
+impl WorkstreamReader {
+    /// Uses only the caller's private runtime directory. Never creates files.
+    #[must_use]
+    pub fn from_environment() -> Option<Self> {
+        let (runtime, uid) = runtime_directory().ok()?;
+        Some(Self {
+            directory: runtime.join("t1-workstream"),
+            uid,
+        })
+    }
+
+    /// Returns the latest fresh hint, or quiet on any failure.
+    #[must_use]
+    pub fn poll(&self) -> Option<WorkstreamEvent> {
+        let record = read_record(&self.directory, self.uid).ok()?;
+        record.fresh_at(uptime_ms().ok()?).then_some(record.event)
+    }
+}
+
+/// Writes optional UI hints. Failures must never prevent the actual work.
+pub struct WorkstreamWriter {
+    directory: PathBuf,
+    uid: u32,
+}
+
+impl WorkstreamWriter {
+    /// Creates a private child of `XDG_RUNTIME_DIR` when necessary.
+    ///
+    /// # Errors
+    /// Returns an error for missing, unsafe, or unwritable runtime storage.
+    pub fn from_environment() -> io::Result<Self> {
+        let (runtime, uid) = runtime_directory()?;
+        let directory = runtime.join("t1-workstream");
+        match fs::DirBuilder::new().mode(0o700).create(&directory) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        validate_directory(&directory, uid)?;
+        Ok(Self { directory, uid })
+    }
+
+    /// Selects a new operation, replacing the currently displayed operation.
+    /// Repeating the selected generation is idempotent, including after expiry.
+    ///
+    /// # Errors
+    /// Returns an error if the bounded write cannot safely complete.
+    pub fn begin(&self, generation: u64, label: &str) -> io::Result<()> {
+        let _lock = self.lock()?;
+        if read_record(&self.directory, self.uid)
+            .is_ok_and(|record| record.event.generation == generation)
+        {
+            return Ok(());
+        }
+        self.write(&Record {
+            event: WorkstreamEvent {
+                generation,
+                phase: WorkstreamPhase::Running,
+                label: sanitize_label(label),
+            },
+            updated_ms: uptime_ms()?,
+        })
+    }
+
+    /// Updates only the selected running operation. `None` preserves its label.
+    /// All three non-running phases are terminal, so delayed events cannot revive
+    /// a finished operation. An expired running record can still finish honestly.
+    ///
+    /// # Errors
+    /// Returns an error if the private record cannot safely be read or written.
+    pub fn update(
+        &self,
+        generation: u64,
+        phase: WorkstreamPhase,
+        label: Option<&str>,
+    ) -> io::Result<bool> {
+        let _lock = self.lock()?;
+        let mut record = read_record(&self.directory, self.uid)?;
+        if record.event.generation != generation || record.event.phase != WorkstreamPhase::Running {
+            return Ok(false);
+        }
+        record.event.phase = phase;
+        if let Some(label) = label {
+            record.event.label = sanitize_label(label);
+        }
+        record.updated_ms = uptime_ms()?;
+        self.write(&record)?;
+        Ok(true)
+    }
+
+    fn lock(&self) -> io::Result<UnixDatagram> {
+        // Rust 1.88 has no safe std flock. This non-receiving abstract socket is
+        // solely a short-lived kernel mutex: no filesystem socket, listening
+        // service, packets, root privileges, or stale lock after process death.
+        let address = SocketAddr::from_abstract_name(format!("t1-workstream-lock-{}", self.uid))?;
+        for _ in 0..10 {
+            match UnixDatagram::bind_addr(&address) {
+                Ok(lock) => return Ok(lock),
+                Err(error) if error.kind() == io::ErrorKind::AddrInUse => {
+                    thread::sleep(Duration::from_millis(5));
+                }
+                Err(error) => return Err(error),
+            }
+        }
+        Err(io::Error::new(
+            io::ErrorKind::WouldBlock,
+            "activity channel busy",
+        ))
+    }
+
+    fn write(&self, record: &Record) -> io::Result<()> {
+        validate_directory(&self.directory, self.uid)?;
+        let pending = self.directory.join("pending");
+        // A crashed transaction can leave this fixed, bounded temporary name.
+        // Unlinking removes a symlink itself and never follows its target.
+        match fs::remove_file(&pending) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error),
+        }
+        let result = (|| {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&pending)?;
+            file.write_all(&record.bytes())?;
+            fs::rename(&pending, self.directory.join("state"))
+        })();
+        if result.is_err() {
+            let _ = fs::remove_file(pending);
+        }
+        result
+    }
+}
+
+/// Stable within this build, with raw operation IDs never stored or displayed.
+#[must_use]
+pub fn generation_for_id(id: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    id.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// A fresh opaque wrapper generation, independent of command arguments.
+///
+/// # Errors
+/// Returns an error if the kernel random source cannot be read.
+pub fn random_generation() -> io::Result<u64> {
+    let mut bytes = [0; 8];
+    File::open("/dev/urandom")?.read_exact(&mut bytes)?;
+    Ok(u64::from_ne_bytes(bytes))
+}
+
+fn sanitize_label(label: &str) -> String {
+    let mut result = String::with_capacity(MAX_LABEL_BYTES);
+    for character in label.chars() {
+        let character = if character.is_ascii_alphanumeric() {
+            character.to_ascii_uppercase()
+        } else if character == '-' || character == '.' {
+            character
+        } else {
+            ' '
+        };
+        if character == ' ' && (result.is_empty() || result.ends_with(' ')) {
+            continue;
+        }
+        result.push(character);
+        if result.len() == MAX_LABEL_BYTES {
+            break;
+        }
+    }
+    let label = result.trim_end();
+    if label.is_empty() {
+        "WORKING".to_owned()
+    } else {
+        label.to_owned()
+    }
+}
+
+fn runtime_directory() -> io::Result<(PathBuf, u32)> {
+    let uid = fs::metadata("/proc/self")?.uid();
+    let runtime = env::var_os("XDG_RUNTIME_DIR")
+        .map(PathBuf::from)
+        .ok_or_else(unsafe_storage)?;
+    if !runtime.is_absolute() {
+        return Err(unsafe_storage());
+    }
+    validate_directory(&runtime, uid)?;
+    Ok((runtime, uid))
+}
+
+fn validate_directory(path: &Path, uid: u32) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    if !metadata.is_dir() || metadata.uid() != uid || metadata.mode() & 0o777 != 0o700 {
+        return Err(unsafe_storage());
+    }
+    Ok(())
+}
+
+fn unsafe_storage() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "activity storage is not private",
+    )
+}
+
+fn read_record(directory: &Path, uid: u32) -> io::Result<Record> {
+    validate_directory(directory, uid)?;
+    // Pin before opening for data, so even a replacement device/FIFO cannot
+    // cause side effects or block the renderer. Match the existing overlay reader.
+    let pinned = OpenOptions::new()
+        .read(true)
+        .custom_flags(O_PATH | O_NOFOLLOW)
+        .open(directory.join("state"))?;
+    let metadata = pinned.metadata()?;
+    if !metadata.is_file()
+        || metadata.uid() != uid
+        || metadata.mode() & 0o777 != 0o600
+        || metadata.len() > MAX_RECORD_BYTES
+        || metadata.nlink() != 1
+    {
+        return Err(unsafe_storage());
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(O_NONBLOCK)
+        .open(Path::new("/proc/self/fd").join(pinned.as_raw_fd().to_string()))?;
+    let opened = file.metadata()?;
+    if opened.dev() != metadata.dev() || opened.ino() != metadata.ino() {
+        return Err(unsafe_storage());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_RECORD_BYTES + 1).read_to_end(&mut bytes)?;
+    Record::parse(&bytes)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "invalid activity record"))
+}
+
+fn uptime_ms() -> io::Result<u64> {
+    let mut text = String::new();
+    File::open("/proc/uptime")?
+        .take(128)
+        .read_to_string(&mut text)?;
+    parse_uptime_ms(&text)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "uptime unavailable"))
+}
+
+fn parse_uptime_ms(text: &str) -> Option<u64> {
+    let (seconds, fraction) = text.split_whitespace().next()?.split_once('.')?;
+    if fraction.is_empty() || !fraction.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    let milliseconds = format!("{fraction:0<3}");
+    seconds
+        .parse::<u64>()
+        .ok()?
+        .checked_mul(1_000)?
+        .checked_add(milliseconds.get(..3)?.parse::<u64>().ok()?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{PermissionsExt, symlink};
+
+    struct Fixture {
+        writer: WorkstreamWriter,
+    }
+
+    impl Fixture {
+        fn new() -> Self {
+            let directory = env::temp_dir().join(format!(
+                "t1-workstream-test-{:016x}",
+                random_generation().unwrap()
+            ));
+            fs::DirBuilder::new()
+                .mode(0o700)
+                .create(&directory)
+                .unwrap();
+            Self {
+                writer: WorkstreamWriter {
+                    directory,
+                    uid: fs::metadata("/proc/self").unwrap().uid(),
+                },
+            }
+        }
+
+        fn reader(&self) -> WorkstreamReader {
+            WorkstreamReader {
+                directory: self.writer.directory.clone(),
+                uid: self.writer.uid,
+            }
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.writer.directory);
+        }
+    }
+
+    #[test]
+    fn expiry_and_future_timestamps_are_quiet() {
+        for phase in [
+            WorkstreamPhase::Running,
+            WorkstreamPhase::Done,
+            WorkstreamPhase::Failed,
+            WorkstreamPhase::Attention,
+        ] {
+            let record = Record {
+                event: WorkstreamEvent {
+                    generation: 1,
+                    phase,
+                    label: "BUILDING".into(),
+                },
+                updated_ms: 20_000,
+            };
+            assert!(record.fresh_at(20_000));
+            assert!(record.fresh_at(20_000 + phase.lifetime_ms() - 1));
+            assert!(!record.fresh_at(20_000 + phase.lifetime_ms()));
+            assert!(!record.fresh_at(19_999));
+        }
+    }
+
+    #[test]
+    fn bounded_labels_cannot_inject_record_fields() {
+        assert_eq!(
+            sanitize_label("  building\n\u{1b}[31m widget 🦀  "),
+            "BUILDING 31M WIDGET"
+        );
+        assert_eq!(sanitize_label("💡"), "WORKING");
+        assert_eq!(sanitize_label(&"x".repeat(1_000)).len(), MAX_LABEL_BYTES);
+        assert!(
+            Record::parse(b"t1-workstream-v1\n0000000000000001\n12\nrunning\nBUILDING\n").is_some()
+        );
+        assert!(
+            Record::parse(b"t1-workstream-v1\n0000000000000001\n12\nrunning\nBUILDING\nEXTRA\n")
+                .is_none()
+        );
+        assert!(Record::parse(b"t1-workstream-v1\n0000000000000001\n12\nrunning\nBad\n").is_none());
+        assert!(Record::parse(&vec![b'a'; 257]).is_none());
+    }
+
+    #[test]
+    fn older_completion_does_not_overwrite_selected_work() {
+        let fixture = Fixture::new();
+        fixture.writer.begin(1, "building").unwrap();
+        fixture.writer.begin(2, "checking").unwrap();
+        assert!(
+            !fixture
+                .writer
+                .update(1, WorkstreamPhase::Done, None)
+                .unwrap()
+        );
+        let event = fixture.reader().poll().unwrap();
+        assert_eq!(event.generation, 2);
+        assert_eq!(event.label, "CHECKING");
+        assert_eq!(event.phase, WorkstreamPhase::Running);
+        assert!(
+            fixture
+                .writer
+                .update(2, WorkstreamPhase::Done, None)
+                .unwrap()
+        );
+        assert_eq!(
+            fixture.reader().poll().unwrap().phase,
+            WorkstreamPhase::Done
+        );
+    }
+
+    #[test]
+    fn late_start_or_update_cannot_revive_terminal_operation() {
+        let fixture = Fixture::new();
+        fixture.writer.begin(3, "working").unwrap();
+        fixture
+            .writer
+            .update(3, WorkstreamPhase::Attention, Some("response ready"))
+            .unwrap();
+        fixture.writer.begin(3, "working").unwrap();
+        assert!(
+            !fixture
+                .writer
+                .update(3, WorkstreamPhase::Running, Some("checking"))
+                .unwrap()
+        );
+        let event = fixture.reader().poll().unwrap();
+        assert_eq!(event.phase, WorkstreamPhase::Attention);
+        assert_eq!(event.label, "RESPONSE READY");
+    }
+
+    #[test]
+    fn expired_running_operation_can_report_observed_completion() {
+        let fixture = Fixture::new();
+        fixture
+            .writer
+            .write(&Record {
+                event: WorkstreamEvent {
+                    generation: 4,
+                    phase: WorkstreamPhase::Running,
+                    label: "WORKING".into(),
+                },
+                updated_ms: 0,
+            })
+            .unwrap();
+        assert!(fixture.reader().poll().is_none());
+        assert!(
+            fixture
+                .writer
+                .update(4, WorkstreamPhase::Attention, Some("response ready"))
+                .unwrap()
+        );
+        assert_eq!(
+            fixture.reader().poll().unwrap().phase,
+            WorkstreamPhase::Attention
+        );
+    }
+
+    #[test]
+    fn unsafe_and_stale_files_are_quiet() {
+        let fixture = Fixture::new();
+        let path = fixture.writer.directory.join("state");
+        assert!(fixture.reader().poll().is_none());
+        symlink("/dev/zero", &path).unwrap();
+        assert!(fixture.reader().poll().is_none());
+        fs::remove_file(&path).unwrap();
+        fixture.writer.begin(1, "building").unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(fixture.reader().poll().is_none());
+        fixture
+            .writer
+            .write(&Record {
+                event: WorkstreamEvent {
+                    generation: 1,
+                    phase: WorkstreamPhase::Running,
+                    label: "BUILDING".into(),
+                },
+                updated_ms: 0,
+            })
+            .unwrap();
+        assert!(fixture.reader().poll().is_none());
+        fs::set_permissions(&fixture.writer.directory, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(fixture.reader().poll().is_none());
+    }
+
+    #[test]
+    fn uptime_is_integer_based_and_rejects_bad_input() {
+        assert_eq!(parse_uptime_ms("123.45 678.90\n"), Some(123_450));
+        assert_eq!(parse_uptime_ms("1.2 0\n"), Some(1_200));
+        assert_eq!(parse_uptime_ms("1.2345 0\n"), Some(1_234));
+        assert_eq!(parse_uptime_ms("-1.23"), None);
+        assert_eq!(parse_uptime_ms("1.nan"), None);
+        assert_eq!(parse_uptime_ms("18446744073709551615.00"), None);
+    }
+}
diff --git a/crates/t1-touchbar/src/workstream_visual.rs b/crates/t1-touchbar/src/workstream_visual.rs
new file mode 100644
index 0000000..48e5df7
--- /dev/null
+++ b/crates/t1-touchbar/src/workstream_visual.rs
@@ -0,0 +1,547 @@
+//! Tokyo Night activity and touch feedback. Motion never owns input or actions.
+
+use std::time::Duration;
+
+use crate::framebuffer::{FramebufferError, Rectangle, Rgb, Xrgb8888Frame};
+use crate::workstream::{WorkstreamEvent, WorkstreamPhase};
+
+const FRAME_INTERVAL: Duration = Duration::from_millis(34);
+const PRESS_DURATION: Duration = Duration::from_millis(240);
+const FINISH_DURATION: Duration = Duration::from_millis(700);
+const BLUE: Rgb = Rgb {
+    red: 122,
+    green: 162,
+    blue: 247,
+};
+const PURPLE: Rgb = Rgb {
+    red: 187,
+    green: 154,
+    blue: 247,
+};
+const GREEN: Rgb = Rgb {
+    red: 158,
+    green: 206,
+    blue: 106,
+};
+const RED: Rgb = Rgb {
+    red: 247,
+    green: 118,
+    blue: 142,
+};
+const YELLOW: Rgb = Rgb {
+    red: 224,
+    green: 175,
+    blue: 104,
+};
+const INK: Rgb = Rgb {
+    red: 192,
+    green: 202,
+    blue: 245,
+};
+const MUTED: Rgb = Rgb {
+    red: 90,
+    green: 100,
+    blue: 141,
+};
+
+pub(crate) struct WorkstreamVisual {
+    event: Option<WorkstreamEvent>,
+    display_label: String,
+    event_since: Duration,
+    press: Option<(Rectangle, Duration)>,
+    last_frame: Duration,
+    was_animating: bool,
+    reduced_motion: bool,
+}
+
+impl WorkstreamVisual {
+    pub(crate) fn new(reduced_motion: bool) -> Self {
+        Self {
+            event: None,
+            display_label: "WORKSTREAM".into(),
+            event_since: Duration::ZERO,
+            press: None,
+            last_frame: Duration::ZERO,
+            was_animating: false,
+            reduced_motion,
+        }
+    }
+
+    pub(crate) fn set_event(&mut self, event: Option<WorkstreamEvent>, now: Duration) -> bool {
+        if self.event == event {
+            return false;
+        }
+        self.display_label = event.as_ref().map_or_else(
+            || "WORKSTREAM".into(),
+            |event| match event.phase {
+                WorkstreamPhase::Done => format!("DONE - {}", event.label),
+                WorkstreamPhase::Failed => format!("FAILED - {}", event.label),
+                WorkstreamPhase::Running | WorkstreamPhase::Attention => event.label.clone(),
+            },
+        );
+        self.event = event;
+        self.event_since = now;
+        true
+    }
+
+    pub(crate) fn press(&mut self, bounds: Rectangle, now: Duration) {
+        if !self.reduced_motion {
+            self.press = Some((bounds, now));
+        }
+    }
+
+    pub(crate) fn cancel_touch(&mut self) {
+        self.press = None;
+    }
+
+    /// Coalesces elapsed frames; returns one final redraw when a transient ends.
+    pub(crate) fn advance(
+        &mut self,
+        now: Duration,
+        ribbon_visible: bool,
+        controls_visible: bool,
+    ) -> bool {
+        if !controls_visible {
+            self.press = None;
+        }
+        if self
+            .press
+            .is_some_and(|(_, start)| now.saturating_sub(start) >= PRESS_DURATION)
+        {
+            self.press = None;
+        }
+        let animating = !self.reduced_motion
+            && (self.press.is_some()
+                || (ribbon_visible
+                    && self.event.as_ref().is_some_and(|event| {
+                        event.phase == WorkstreamPhase::Running
+                            || (event.phase == WorkstreamPhase::Done
+                                && now.saturating_sub(self.event_since) < FINISH_DURATION)
+                    })));
+        let ended = self.was_animating && !animating;
+        self.was_animating = animating;
+        if ended || (animating && now.saturating_sub(self.last_frame) >= FRAME_INTERVAL) {
+            self.last_frame = now;
+            controls_visible
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn render(
+        &self,
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        now: Duration,
+    ) -> Result<(), FramebufferError> {
+        if bounds.width < 24 || bounds.height < 16 {
+            return Ok(());
+        }
+        let color = match self.event.as_ref() {
+            None => MUTED,
+            Some(event) => match event.phase {
+                WorkstreamPhase::Running => BLUE,
+                WorkstreamPhase::Done => GREEN,
+                WorkstreamPhase::Failed => RED,
+                WorkstreamPhase::Attention => YELLOW,
+            },
+        };
+        let label_color = if self.event.is_some() { INK } else { MUTED };
+        draw_text(frame, bounds, &self.display_label, label_color)?;
+        let running = self
+            .event
+            .as_ref()
+            .is_some_and(|event| event.phase == WorkstreamPhase::Running)
+            && !self.reduced_motion;
+        let seconds = if running {
+            now.saturating_sub(self.event_since).as_secs_f64()
+        } else {
+            0.0
+        };
+        let bottom = bounds.y + bounds.height * 4 / 5;
+        let width = bounds.width.saturating_sub(16);
+        for x in 0..width {
+            let fraction = f64::from(x) / f64::from(width);
+            let envelope = (fraction * std::f64::consts::PI).sin();
+            for (layer, ink) in [color, PURPLE].into_iter().enumerate() {
+                let amplitude = if running {
+                    f64::from(bounds.height) * 0.12
+                } else {
+                    0.0
+                };
+                let y = f64::from(bottom)
+                    + (fraction
+                        * std::f64::consts::TAU
+                        * (2.0 + f64::from(u8::try_from(layer).unwrap_or(0)))
+                        - seconds * 2.8)
+                        .sin()
+                        * amplitude
+                        * envelope;
+                let ink = if layer == 0 || !running { color } else { ink };
+                draw_vertical_sample(
+                    frame,
+                    bounds,
+                    bounds.x + 8 + x,
+                    y,
+                    ink,
+                    if layer == 0 { 240 } else { 170 },
+                )?;
+                if running {
+                    draw_vertical_sample(frame, bounds, bounds.x + 8 + x, y + 1.0, ink, 150)?;
+                }
+            }
+        }
+        if running {
+            self.render_running_signal(frame, bounds, seconds)?;
+            let fraction = (seconds / 2.8).fract();
+            let y = f64::from(bottom)
+                + (fraction * std::f64::consts::TAU * 2.0 - seconds * 2.8).sin()
+                    * f64::from(bounds.height)
+                    * 0.12
+                    * (fraction * std::f64::consts::PI).sin();
+            draw_glow(
+                frame,
+                bounds,
+                f64::from(bounds.x + 8) + fraction * f64::from(width.saturating_sub(1)),
+                y,
+                INK,
+                255,
+                4,
+            )?;
+        }
+        self.render_completion(frame, bounds, now)
+    }
+
+    fn render_completion(
+        &self,
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        now: Duration,
+    ) -> Result<(), FramebufferError> {
+        let width = bounds.width.saturating_sub(16);
+        let bottom = bounds.y + bounds.height * 4 / 5;
+        if let Some(event) = &self.event {
+            let elapsed = now.saturating_sub(self.event_since);
+            if event.phase == WorkstreamPhase::Done
+                && !self.reduced_motion
+                && elapsed < FINISH_DURATION
+            {
+                let x = bounds.x
+                    + 8
+                    + u32::try_from(
+                        u128::from(width.saturating_sub(1)) * elapsed.as_nanos()
+                            / FINISH_DURATION.as_nanos(),
+                    )
+                    .unwrap_or(0);
+                for dx in 0..5 {
+                    if x + dx < bounds.x + bounds.width {
+                        frame.blend_rectangle(
+                            Rectangle {
+                                x: x + dx,
+                                y: bottom.saturating_sub(1),
+                                width: 1,
+                                height: 3,
+                            },
+                            GREEN,
+                            210_u8.saturating_sub(u8::try_from(dx * 35).unwrap_or(210)),
+                        )?;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn render_running_signal(
+        &self,
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        seconds: f64,
+    ) -> Result<(), FramebufferError> {
+        let scale = (bounds.height / 20).clamp(1, 3);
+        let text_width = u32::try_from(self.display_label.len()).unwrap_or(0) * 6 * scale;
+        let left = bounds.x + bounds.width.saturating_sub(text_width) / 2;
+        if left < bounds.x + 30 || bounds.height < 30 {
+            return Ok(());
+        }
+        let center_x = f64::from(left - 20);
+        let center_y = f64::from(bounds.y + bounds.height / 5) + f64::from(7 * scale) / 2.0;
+        for dot in 0..12 {
+            let angle = f64::from(dot) * std::f64::consts::TAU / 12.0;
+            let light = f64::midpoint((angle - seconds * std::f64::consts::TAU).cos(), 1.0);
+            let alpha = u8::try_from(pixel_from_float(30.0 + 225.0 * light.powi(3))).unwrap_or(255);
+            draw_glow(
+                frame,
+                bounds,
+                center_x + angle.cos() * 9.0,
+                center_y + angle.sin() * 9.0,
+                BLUE,
+                alpha,
+                2,
+            )?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn render_touch(
+        &self,
+        frame: &mut Xrgb8888Frame<'_>,
+        now: Duration,
+    ) -> Result<(), FramebufferError> {
+        let Some((bounds, start)) = self.press else {
+            return Ok(());
+        };
+        let elapsed = now.saturating_sub(start);
+        if elapsed >= PRESS_DURATION || bounds.width < 4 || bounds.height < 4 {
+            return Ok(());
+        }
+        let progress = elapsed.as_secs_f64() / PRESS_DURATION.as_secs_f64();
+        let extent = pixel_from_float(f64::from(bounds.width - 4) * (0.2 + 0.8 * progress)).max(1);
+        let alpha = u8::try_from(pixel_from_float(180.0 * (1.0 - progress))).unwrap_or(0);
+        frame.blend_rectangle(
+            Rectangle {
+                x: bounds.x + (bounds.width - extent) / 2,
+                y: bounds.y + bounds.height - 4,
+                width: extent,
+                height: 2,
+            },
+            BLUE,
+            alpha,
+        )
+    }
+}
+
+#[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+fn pixel_from_float(value: f64) -> u32 {
+    value.max(0.0) as u32
+}
+
+fn draw_glow(
+    frame: &mut Xrgb8888Frame<'_>,
+    clip: Rectangle,
+    x: f64,
+    y: f64,
+    color: Rgb,
+    alpha: u8,
+    radius: i32,
+) -> Result<(), FramebufferError> {
+    for dy in -radius..=radius {
+        for dx in -radius..=radius {
+            let px = x + f64::from(dx);
+            let py = y + f64::from(dy);
+            if px < f64::from(clip.x)
+                || px >= f64::from(clip.x + clip.width)
+                || py < f64::from(clip.y)
+                || py >= f64::from(clip.y + clip.height)
+            {
+                continue;
+            }
+            let distance = f64::from(dx * dx + dy * dy) / f64::from(radius * radius);
+            let weight = (1.0 - distance).max(0.0);
+            frame.blend_rectangle(
+                Rectangle {
+                    x: pixel_from_float(px),
+                    y: pixel_from_float(py),
+                    width: 1,
+                    height: 1,
+                },
+                color,
+                u8::try_from(pixel_from_float(f64::from(alpha) * weight)).unwrap_or(0),
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn draw_vertical_sample(
+    frame: &mut Xrgb8888Frame<'_>,
+    clip: Rectangle,
+    x: u32,
+    y: f64,
+    color: Rgb,
+    alpha: u8,
+) -> Result<(), FramebufferError> {
+    let top = pixel_from_float(y);
+    let fraction = y.fract().abs();
+    for (offset, weight) in [(0, 1.0 - fraction), (1, fraction)] {
+        if top + offset >= clip.y && top + offset < clip.y + clip.height {
+            frame.blend_rectangle(
+                Rectangle {
+                    x,
+                    y: top + offset,
+                    width: 1,
+                    height: 1,
+                },
+                color,
+                u8::try_from(pixel_from_float(f64::from(alpha) * weight)).unwrap_or(0),
+            )?;
+        }
+    }
+    Ok(())
+}
+
+/// Small original bitmap alphabet; no fonts, assets or allocations in a frame.
+fn draw_text(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    label: &str,
+    color: Rgb,
+) -> Result<(), FramebufferError> {
+    let scale = (bounds.height / 20).clamp(1, 3);
+    let limit = usize::try_from(bounds.width.saturating_sub(20) / (6 * scale)).unwrap_or(0);
+    let count = label.len().min(limit);
+    let text_width = u32::try_from(count).unwrap_or(0) * 6 * scale;
+    let left = bounds.x + (bounds.width.saturating_sub(text_width)) / 2;
+    let top = bounds.y + bounds.height / 5;
+    for (index, character) in label.bytes().take(count).enumerate() {
+        let columns = glyph(character);
+        for (column, bits) in columns.into_iter().enumerate() {
+            for row in 0..7 {
+                if bits & (1 << row) != 0 {
+                    let x = left
+                        + (u32::try_from(index).unwrap_or(0) * 6
+                            + u32::try_from(column).unwrap_or(0))
+                            * scale;
+                    let y = top + row * scale;
+                    if x + scale <= bounds.x + bounds.width && y + scale <= bounds.y + bounds.height
+                    {
+                        frame.fill_rectangle(
+                            Rectangle {
+                                x,
+                                y,
+                                width: scale,
+                                height: scale,
+                            },
+                            color,
+                        )?;
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+const fn glyph(character: u8) -> [u8; 5] {
+    match character.to_ascii_uppercase() {
+        b'A' => [126, 9, 9, 9, 126],
+        b'B' => [127, 73, 73, 73, 54],
+        b'C' => [62, 65, 65, 65, 34],
+        b'D' => [127, 65, 65, 34, 28],
+        b'E' => [127, 73, 73, 73, 65],
+        b'F' => [127, 9, 9, 9, 1],
+        b'G' => [62, 65, 73, 73, 122],
+        b'H' => [127, 8, 8, 8, 127],
+        b'I' => [0, 65, 127, 65, 0],
+        b'J' => [32, 64, 65, 63, 1],
+        b'K' => [127, 8, 20, 34, 65],
+        b'L' => [127, 64, 64, 64, 64],
+        b'M' => [127, 2, 12, 2, 127],
+        b'N' => [127, 4, 8, 16, 127],
+        b'O' => [62, 65, 65, 65, 62],
+        b'P' => [127, 9, 9, 9, 6],
+        b'Q' => [62, 65, 81, 33, 94],
+        b'R' => [127, 9, 25, 41, 70],
+        b'S' => [38, 73, 73, 73, 50],
+        b'T' => [1, 1, 127, 1, 1],
+        b'U' => [63, 64, 64, 64, 63],
+        b'V' => [31, 32, 64, 32, 31],
+        b'W' => [63, 64, 56, 64, 63],
+        b'X' => [99, 20, 8, 20, 99],
+        b'Y' => [7, 8, 112, 8, 7],
+        b'Z' => [97, 81, 73, 69, 67],
+        b'0' => [62, 81, 73, 69, 62],
+        b'1' => [0, 66, 127, 64, 0],
+        b'2' => [98, 81, 73, 73, 70],
+        b'3' => [34, 65, 73, 73, 54],
+        b'4' => [24, 20, 18, 127, 16],
+        b'5' => [39, 69, 69, 69, 57],
+        b'6' => [60, 74, 73, 73, 48],
+        b'7' => [1, 113, 9, 5, 3],
+        b'8' => [54, 73, 73, 73, 54],
+        b'9' => [6, 73, 73, 41, 30],
+        b'-' => [8; 5],
+        b'.' => [0, 96, 96, 0, 0],
+        b'!' => [0, 0, 95, 0, 0],
+        _ => [0; 5],
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn event(phase: WorkstreamPhase) -> WorkstreamEvent {
+        WorkstreamEvent {
+            generation: 1,
+            phase,
+            label: "CHECKING".into(),
+        }
+    }
+    #[test]
+    fn idle_is_static_and_active_frames_are_capped_and_coalesced() {
+        let mut visual = WorkstreamVisual::new(false);
+        assert!(!visual.advance(Duration::from_secs(10), true, true));
+        visual.set_event(Some(event(WorkstreamPhase::Running)), Duration::ZERO);
+        assert!(visual.advance(Duration::from_millis(34), true, true));
+        assert!(!visual.advance(Duration::from_millis(35), true, true));
+        assert!(visual.advance(Duration::from_secs(10), true, true));
+        assert!(!visual.advance(Duration::from_secs(10), true, true));
+        visual.set_event(None, Duration::from_secs(10));
+        assert!(visual.advance(Duration::from_secs(11), true, true));
+        assert!(!visual.advance(Duration::from_secs(12), true, true));
+    }
+    #[test]
+    fn completion_and_touch_settle_and_blanking_cancels_touch() {
+        let mut visual = WorkstreamVisual::new(false);
+        visual.set_event(Some(event(WorkstreamPhase::Done)), Duration::ZERO);
+        assert!(visual.advance(Duration::from_millis(34), true, true));
+        assert!(visual.advance(Duration::from_millis(700), true, true));
+        assert!(!visual.advance(Duration::from_secs(1), true, true));
+        visual.press(
+            Rectangle {
+                x: 0,
+                y: 0,
+                width: 30,
+                height: 60,
+            },
+            Duration::from_secs(1),
+        );
+        assert!(visual.advance(Duration::from_millis(1100), true, true));
+        assert!(!visual.advance(Duration::from_millis(1101), false, false));
+        assert!(visual.press.is_none());
+        assert!(!visual.advance(Duration::from_secs(2), true, true));
+    }
+    #[test]
+    fn reduced_motion_and_hidden_ribbon_do_not_animate() {
+        let mut visual = WorkstreamVisual::new(true);
+        visual.set_event(Some(event(WorkstreamPhase::Running)), Duration::ZERO);
+        assert!(!visual.advance(Duration::from_secs(1), true, true));
+        let mut visual = WorkstreamVisual::new(false);
+        visual.set_event(Some(event(WorkstreamPhase::Running)), Duration::ZERO);
+        assert!(!visual.advance(Duration::from_secs(1), false, true));
+    }
+    #[test]
+    fn motion_stays_inside_its_reserved_region() {
+        let mut pixels = vec![0; 400 * 60 * 4];
+        let mut frame = Xrgb8888Frame::new(400, 60, 1600, &mut pixels).unwrap();
+        let mut visual = WorkstreamVisual::new(false);
+        visual.set_event(Some(event(WorkstreamPhase::Running)), Duration::ZERO);
+        visual
+            .render(
+                &mut frame,
+                Rectangle {
+                    x: 100,
+                    y: 0,
+                    width: 200,
+                    height: 60,
+                },
+                Duration::from_millis(200),
+            )
+            .unwrap();
+        assert!(frame.as_bytes().iter().any(|byte| *byte != 0));
+        for row in frame.as_bytes().as_chunks::<1600>().0 {
+            assert!(row[..400].iter().all(|byte| *byte == 0));
+            assert!(row[1200..].iter().all(|byte| *byte == 0));
+        }
+    }
+}
