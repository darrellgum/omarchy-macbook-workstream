@@ -0,0 +1,257 @@
+//! Optional, advisory Codex lifecycle adapter. Never forwards conversation content.
+
+use std::env;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use serde_json::Value;
+
+const MAX_INPUT_BYTES: usize = 64 * 1024;
+const MAX_IDENTIFIER_BYTES: usize = 512;
+const CHILD_DEADLINE: Duration = Duration::from_millis(200);
+const CHILD_POLL: Duration = Duration::from_millis(5);
+
+#[derive(Debug, PartialEq, Eq)]
+struct Signal {
+    operation: &'static str,
+    id: String,
+    label: &'static str,
+}
+
+fn main() {
+    if let Some(signal) = read_signal(io::stdin().lock())
+        && let Some(executable) = sibling_executable()
+    {
+        dispatch(&executable, &signal);
+    }
+    // Stop requires JSON; this also remains harmless for the other events.
+    // A missing renderer, bad payload, or broken output pipe must not affect Codex.
+    let _ = io::stdout().lock().write_all(b"{}\n");
+}
+
+fn read_signal(input: impl Read) -> Option<Signal> {
+    let mut bytes = Vec::new();
+    input
+        .take(u64::try_from(MAX_INPUT_BYTES).ok()?.saturating_add(1))
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() > MAX_INPUT_BYTES {
+        return None;
+    }
+    let value: Value = serde_json::from_slice(&bytes).ok()?;
+    signal_for(&value)
+}
+
+fn signal_for(value: &Value) -> Option<Signal> {
+    let (operation, label) = match value.get("hook_event_name")?.as_str()? {
+        "UserPromptSubmit" => ("begin", "WORKING"),
+        "Stop" => ("attention", "RESPONSE READY"),
+        "Interrupt" => ("attention", "INTERRUPTED"),
+        _ => return None,
+    };
+    let session = identifier(value.get("session_id")?)?;
+    let turn = identifier(value.get("turn_id")?)?;
+    Some(Signal {
+        operation,
+        id: operation_id(session, turn),
+        label,
+    })
+}
+
+fn identifier(value: &Value) -> Option<&str> {
+    let text = value.as_str()?;
+    // The documented contract says string, without prescribing an ID alphabet.
+    // These values are hashed, never used as paths, labels, or raw arguments.
+    if text.is_empty() || text.len() > MAX_IDENTIFIER_BYTES {
+        return None;
+    }
+    Some(text)
+}
+
+fn operation_id(session: &str, turn: &str) -> String {
+    // IDs correlate lifecycle events only. Hashing keeps raw session identifiers
+    // out of command arguments and renderer state; it is not anonymization.
+    let mut hash = DefaultHasher::new();
+    (session, turn).hash(&mut hash);
+    format!("codex-{:016x}", hash.finish())
+}
+
+fn sibling_executable() -> Option<PathBuf> {
+    Some(env::current_exe().ok()?.parent()?.join("t1-workstream"))
+}
+
+fn dispatch(executable: &Path, signal: &Signal) {
+    let Ok(mut child) = Command::new(executable)
+        .args([signal.operation, signal.id.as_str(), signal.label])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+    else {
+        return;
+    };
+    finish_child(&mut child, CHILD_DEADLINE);
+}
+
+fn finish_child(child: &mut Child, deadline: Duration) {
+    let started = Instant::now();
+    loop {
+        match child.try_wait() {
+            Ok(Some(_)) => return,
+            Ok(None) if started.elapsed() < deadline => thread::sleep(CHILD_POLL),
+            Ok(None) | Err(_) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn event(name: &str) -> Value {
+        json!({
+            "hook_event_name": name,
+            "session_id": "synthetic-session-1",
+            "turn_id": "synthetic-turn-1",
+        })
+    }
+
+    #[test]
+    fn supported_events_emit_only_fixed_labels() {
+        for (name, operation, label) in [
+            ("UserPromptSubmit", "begin", "WORKING"),
+            ("Stop", "attention", "RESPONSE READY"),
+            ("Interrupt", "attention", "INTERRUPTED"),
+        ] {
+            let mut input = event(name);
+            input["prompt"] = json!("SYNTHETIC PRIVATE PROMPT");
+            input["last_assistant_message"] = json!("SYNTHETIC PRIVATE OUTPUT");
+            input["tool_input"] = json!({"command": "SYNTHETIC PRIVATE COMMAND"});
+            input["transcript_path"] = json!("/synthetic/transcript-do-not-open");
+            let signal = signal_for(&input).unwrap();
+            assert_eq!(signal.operation, operation);
+            assert_eq!(signal.label, label);
+            assert!(signal.id.starts_with("codex-"));
+            assert!(!format!("{signal:?}").contains("PRIVATE"));
+            assert!(!signal.id.contains("synthetic"));
+        }
+    }
+
+    #[test]
+    fn sessions_and_turns_have_distinct_operation_ids() {
+        assert_eq!(
+            operation_id("session-a", "turn-a"),
+            operation_id("session-a", "turn-a")
+        );
+        assert_ne!(
+            operation_id("session-a", "turn-a"),
+            operation_id("session-b", "turn-a")
+        );
+        assert_ne!(
+            operation_id("session-a", "turn-a"),
+            operation_id("session-a", "turn-b")
+        );
+        assert_ne!(operation_id("a", "bc"), operation_id("ab", "c"));
+    }
+
+    #[test]
+    fn malformed_or_unsupported_events_are_ignored() {
+        for name in [
+            "PermissionRequest",
+            "PreToolUse",
+            "PostToolUse",
+            "SessionStart",
+            "SubagentStop",
+            "",
+        ] {
+            assert!(signal_for(&event(name)).is_none());
+        }
+        for bad in [
+            json!(null),
+            json!(9),
+            json!(""),
+            json!("a".repeat(MAX_IDENTIFIER_BYTES + 1)),
+        ] {
+            let mut input = event("Stop");
+            input["turn_id"] = bad;
+            assert!(signal_for(&input).is_none());
+        }
+        let mut missing = event("Stop");
+        missing.as_object_mut().unwrap().remove("session_id");
+        assert!(signal_for(&missing).is_none());
+        assert!(read_signal(&b"invalid json"[..]).is_none());
+        assert!(read_signal(&b"[]"[..]).is_none());
+    }
+
+    #[test]
+    fn identifiers_are_opaque_strings_without_a_format_assumption() {
+        let mut input = event("Stop");
+        input["session_id"] = json!("synthetic:session/東京");
+        input["turn_id"] = json!("synthetic turn with\ncontrol");
+        let signal = signal_for(&input).unwrap();
+        assert_eq!(signal.id.len(), "codex-".len() + 16);
+        assert!(
+            signal.id["codex-".len()..]
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+        );
+    }
+
+    #[test]
+    fn input_has_a_strict_byte_limit() {
+        let mut input = serde_json::to_vec(&event("Stop")).unwrap();
+        input.resize(MAX_INPUT_BYTES, b' ');
+        assert!(read_signal(input.as_slice()).is_some());
+        input.push(b' ');
+        assert!(read_signal(input.as_slice()).is_none());
+    }
+
+    #[test]
+    fn read_errors_are_ignored() {
+        struct BrokenInput;
+        impl Read for BrokenInput {
+            fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+                Err(io::Error::other("synthetic input failure"))
+            }
+        }
+        assert!(read_signal(BrokenInput).is_none());
+    }
+
+    #[test]
+    fn missing_sibling_does_not_fail_the_hook() {
+        let missing = env::temp_dir().join(format!("t1-workstream-absent-{}", std::process::id()));
+        dispatch(&missing, &signal_for(&event("Stop")).unwrap());
+    }
+
+    #[test]
+    fn slow_child_is_killed_and_reaped() {
+        let mut child = Command::new(env::current_exe().unwrap())
+            .args(["--exact", "tests::child_process_fixture", "--nocapture"])
+            .env("T1_WORKSTREAM_TEST_SLOW_CHILD", "1")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        let started = Instant::now();
+        finish_child(&mut child, Duration::from_millis(30));
+        assert!(started.elapsed() < Duration::from_secs(2));
+        assert!(child.try_wait().unwrap().is_some());
+    }
+
+    #[test]
+    fn child_process_fixture() {
+        if env::var_os("T1_WORKSTREAM_TEST_SLOW_CHILD").is_some() {
+            thread::sleep(Duration::from_secs(10));
+        }
+    }
+}
