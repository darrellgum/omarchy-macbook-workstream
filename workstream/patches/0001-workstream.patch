index 0000000..d51a8b7
--- /dev/null
+++ b/crates/t1-touchbar/src/bin/t1-workstream.rs
@@ -0,0 +1,151 @@
+//! Explicit local command activity for the optional Workstream ribbon.
+
+use std::env;
+use std::ffi::OsString;
+use std::io;
+use std::os::unix::process::ExitStatusExt;
+use std::process::{Command, ExitCode, ExitStatus};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use t1_touchbar::workstream::{
+    WorkstreamPhase, WorkstreamWriter, generation_for_id, random_generation,
+};
+
+const USAGE: &str = "Usage: t1-workstream run LABEL -- COMMAND [ARG...]\n       t1-workstream begin ID LABEL\n       t1-workstream update ID LABEL\n       t1-workstream done|failed|attention ID [LABEL]\n\nIDs must be unique per operation. Only the explicit label is displayed.\nThe latest operation wins. Stale activity goes quiet; no progress is inferred.\nDone, failed, and attention finish an operation; later updates are ignored.";
+
+fn main() -> ExitCode {
+    let arguments: Vec<OsString> = env::args_os().skip(1).collect();
+    match arguments.first().and_then(|argument| argument.to_str()) {
+        Some("run") if arguments.len() >= 4 && arguments[2] == "--" => {
+            run_command(&arguments[1], &arguments[3..])
+        }
+        Some("--help" | "-h") => {
+            println!("{USAGE}");
+            ExitCode::SUCCESS
+        }
+        Some("begin" | "update" | "done" | "failed" | "attention") => event_command(&arguments),
+        _ => {
+            eprintln!("{USAGE}");
+            ExitCode::from(2)
+        }
+    }
+}
+
+fn run_command(label: &OsString, command: &[OsString]) -> ExitCode {
+    let mut child = match Command::new(&command[0]).args(&command[1..]).spawn() {
+        Ok(child) => child,
+        Err(error) => {
+            eprintln!("t1-workstream: command could not be started");
+            return ExitCode::from(if error.kind() == io::ErrorKind::NotFound {
+                127
+            } else {
+                126
+            });
+        }
+    };
+    // UI failure never prevents execution, changes the command, or captures its I/O.
+    let writer = WorkstreamWriter::from_environment().ok();
+    let generation = random_generation().ok();
+    let activity = writer
+        .as_ref()
+        .zip(generation)
+        .filter(|(writer, generation)| writer.begin(*generation, &label.to_string_lossy()).is_ok());
+    let mut heartbeat = Instant::now();
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                if let Some((writer, generation)) = activity {
+                    let phase = if status.success() {
+                        WorkstreamPhase::Done
+                    } else {
+                        WorkstreamPhase::Failed
+                    };
+                    let _ = writer.update(generation, phase, None);
+                }
+                return status_code(status);
+            }
+            Ok(None) => {}
+            Err(_) => {
+                // Waiting is still attempted after a transient status-query error.
+                return child.wait().map_or(ExitCode::FAILURE, status_code);
+            }
+        }
+        if heartbeat.elapsed() >= Duration::from_secs(1) {
+            if let Some((writer, generation)) = activity {
+                let _ = writer.update(generation, WorkstreamPhase::Running, None);
+            }
+            heartbeat = Instant::now();
+        }
+        thread::sleep(Duration::from_millis(50));
+    }
+}
+
+fn status_code(status: ExitStatus) -> ExitCode {
+    let code = status
+        .code()
+        .unwrap_or_else(|| 128 + status.signal().unwrap_or(1));
+    ExitCode::from(u8::try_from(code).unwrap_or(1))
+}
+
+fn event_command(arguments: &[OsString]) -> ExitCode {
+    let Some(action) = arguments[0].to_str() else {
+        return ExitCode::from(2);
+    };
+    let valid_count = if action == "begin" || action == "update" {
+        arguments.len() == 3
+    } else {
+        (2..=3).contains(&arguments.len())
+    };
+    let Some(id) = arguments.get(1).and_then(|argument| argument.to_str()) else {
+        eprintln!("{USAGE}");
+        return ExitCode::from(2);
+    };
+    if !valid_count || id.is_empty() || id.len() > 256 {
+        eprintln!("{USAGE}");
+        return ExitCode::from(2);
+    }
+    let result = (|| {
+        let writer = WorkstreamWriter::from_environment()?;
+        let generation = generation_for_id(id);
+        match action {
+            "begin" => writer.begin(generation, &arguments[2].to_string_lossy()),
+            "update" => writer
+                .update(
+                    generation,
+                    WorkstreamPhase::Running,
+                    Some(&arguments[2].to_string_lossy()),
+                )
+                .map(|_| ()),
+            _ => {
+                let phase = match action {
+                    "done" => WorkstreamPhase::Done,
+                    "failed" => WorkstreamPhase::Failed,
+                    _ => WorkstreamPhase::Attention,
+                };
+                let label = arguments.get(2).map(|argument| argument.to_string_lossy());
+                writer
+                    .update(generation, phase, label.as_deref())
+                    .map(|_| ())
+            }
+        }
+    })();
+    if result.is_err() {
+        eprintln!("t1-workstream: activity display unavailable");
+        ExitCode::FAILURE
+    } else {
+        ExitCode::SUCCESS
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preserves_failure_and_signal_exit_codes() {
+        // These raw wait statuses are synthetic Linux/POSIX values.
+        assert_eq!(status_code(ExitStatus::from_raw(7 << 8)), ExitCode::from(7));
+        assert_eq!(status_code(ExitStatus::from_raw(15)), ExitCode::from(143));
+    }
+}
