+//! Tokyo Night renderer using the maintained controls without selection recursion.
+
+use std::env;
+
+use t1_touchbar::builtin_renderer;
+use t1_touchbar::desktop_provider::{PROVIDER_ENVIRONMENT, resolve_provider_path};
+
+fn main() {
+    let provider_value = env::var_os(PROVIDER_ENVIRONMENT);
+    let provider_path = resolve_provider_path(provider_value.as_deref());
+    builtin_renderer::run_workstream_forever(provider_path.as_deref());
+}
diff --git a/crates/t1-touchbar/src/bin/t1-workstream-claude.rs b/crates/t1-touchbar/src/bin/t1-workstream-claude.rs
new file mode 100644
index 0000000..d047652
--- /dev/null
+++ b/crates/t1-touchbar/src/bin/t1-workstream-claude.rs
@@ -0,0 +1,235 @@
+//! Optional, advisory Claude Code hooks. Never forwards conversation content.
+
+use std::env;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::io::{self, Read};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use serde_json::Value;
+
+const MAX_INPUT_BYTES: usize = 64 * 1024;
+const MAX_IDENTIFIER_BYTES: usize = 512;
+const CHILD_DEADLINE: Duration = Duration::from_millis(200);
+const CHILD_POLL: Duration = Duration::from_millis(5);
+
+#[derive(Debug, PartialEq, Eq)]
+struct Signal {
+    operation: &'static str,
+    id: String,
+    label: &'static str,
+}
+
+fn main() {
+    if let Some(signal) = read_signal(io::stdin().lock())
+        && let Some(executable) = sibling_executable()
+    {
+        dispatch(&executable, &signal);
+    }
+    // Exit zero without output: no decision, context injection, or continuation.
+    // Unavailable optional UI must never interfere with Claude's actual work.
+}
+
+fn read_signal(input: impl Read) -> Option<Signal> {
+    let mut bytes = Vec::new();
+    input
+        .take(u64::try_from(MAX_INPUT_BYTES).ok()?.saturating_add(1))
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() > MAX_INPUT_BYTES {
+        return None;
+    }
+    let value: Value = serde_json::from_slice(&bytes).ok()?;
+    signal_for(&value)
+}
+
+fn signal_for(value: &Value) -> Option<Signal> {
+    // Subagents may inherit configured hooks and share the parent's prompt ID.
+    // Their activity must not start or finish the main conversation's operation.
+    if value.get("agent_id").is_some_and(|agent| !agent.is_null()) {
+        return None;
+    }
+    let (operation, label) = match value.get("hook_event_name")?.as_str()? {
+        "UserPromptSubmit" => ("begin", "CLAUDE WORKING"),
+        "Stop" => ("attention", "RESPONSE READY"),
+        "StopFailure" => ("failed", "CLAUDE ERROR"),
+        _ => return None,
+    };
+    let session = identifier(value.get("session_id")?)?;
+    // Since Claude Code 2.1.196 this common field identifies a specific prompt.
+    // A session-only fallback would let an old Stop finish a newer prompt.
+    let prompt = identifier(value.get("prompt_id")?)?;
+    Some(Signal {
+        operation,
+        id: operation_id(session, prompt),
+        label,
+    })
+}
+
+fn identifier(value: &Value) -> Option<&str> {
+    let text = value.as_str()?;
+    if text.is_empty() || text.len() > MAX_IDENTIFIER_BYTES {
+        return None;
+    }
+    Some(text)
+}
+
+fn operation_id(session: &str, prompt: &str) -> String {
+    // Correlation only, not anonymization. No raw identifier becomes a path,
+    // process argument, display label, or runtime record.
+    let mut hash = DefaultHasher::new();
+    (session, prompt).hash(&mut hash);
+    format!("claude-{:016x}", hash.finish())
+}
+
+fn sibling_executable() -> Option<PathBuf> {
+    Some(env::current_exe().ok()?.parent()?.join("t1-workstream"))
+}
+
+fn dispatch(executable: &Path, signal: &Signal) {
+    let Ok(mut child) = Command::new(executable)
+        .args([signal.operation, signal.id.as_str(), signal.label])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+    else {
+        return;
+    };
+    finish_child(&mut child, CHILD_DEADLINE);
+}
+
+fn finish_child(child: &mut Child, deadline: Duration) {
+    let started = Instant::now();
+    loop {
+        match child.try_wait() {
+            Ok(Some(_)) => return,
+            Ok(None) if started.elapsed() < deadline => thread::sleep(CHILD_POLL),
+            Ok(None) | Err(_) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn event(name: &str) -> Value {
+        json!({
+            "hook_event_name": name,
+            "session_id": "synthetic-session-1",
+            "prompt_id": "synthetic-prompt-1",
+        })
+    }
+
+    #[test]
+    fn supported_events_use_fixed_labels_and_opaque_ids() {
+        for (name, operation, label) in [
+            ("UserPromptSubmit", "begin", "CLAUDE WORKING"),
+            ("Stop", "attention", "RESPONSE READY"),
+            ("StopFailure", "failed", "CLAUDE ERROR"),
+        ] {
+            let mut input = event(name);
+            input["prompt"] = json!("SYNTHETIC PRIVATE PROMPT");
+            input["last_assistant_message"] = json!("SYNTHETIC PRIVATE OUTPUT");
+            input["error_details"] = json!("SYNTHETIC PRIVATE ERROR");
+            input["transcript_path"] = json!("/synthetic/transcript-do-not-open");
+            let signal = signal_for(&input).unwrap();
+            assert_eq!(signal.operation, operation);
+            assert_eq!(signal.label, label);
+            assert_eq!(signal.id.len(), "claude-".len() + 16);
+            assert!(signal.id.starts_with("claude-"));
+            assert!(!format!("{signal:?}").contains("PRIVATE"));
+            assert!(!signal.id.contains("synthetic"));
+        }
+    }
+
+    #[test]
+    fn every_session_and_prompt_has_a_distinct_operation() {
+        assert_eq!(operation_id("a", "1"), operation_id("a", "1"));
+        assert_ne!(operation_id("a", "1"), operation_id("a", "2"));
+        assert_ne!(operation_id("a", "1"), operation_id("b", "1"));
+        assert_ne!(operation_id("a", "bc"), operation_id("ab", "c"));
+    }
+
+    #[test]
+    fn incomplete_older_version_and_subagent_events_are_quiet() {
+        for field in ["session_id", "prompt_id"] {
+            let mut missing = event("Stop");
+            missing.as_object_mut().unwrap().remove(field);
+            assert!(signal_for(&missing).is_none());
+            for invalid in [
+                json!(null),
+                json!(true),
+                json!(4),
+                json!(""),
+                json!("a".repeat(MAX_IDENTIFIER_BYTES + 1)),
+            ] {
+                let mut input = event("Stop");
+                input[field] = invalid;
+                assert!(signal_for(&input).is_none());
+            }
+        }
+        let mut child = event("Stop");
+        child["agent_id"] = json!("synthetic-subagent");
+        assert!(signal_for(&child).is_none());
+        child["agent_id"] = json!(null);
+        assert!(signal_for(&child).is_some());
+        for name in [
+            "SubagentStop",
+            "Interrupt",
+            "Notification",
+            "PreToolUse",
+            "",
+        ] {
+            assert!(signal_for(&event(name)).is_none());
+        }
+    }
+
+    #[test]
+    fn parser_rejects_oversized_and_invalid_input() {
+        let mut input = serde_json::to_vec(&event("Stop")).unwrap();
+        input.resize(MAX_INPUT_BYTES, b' ');
+        assert!(read_signal(input.as_slice()).is_some());
+        input.push(b' ');
+        assert!(read_signal(input.as_slice()).is_none());
+        assert!(read_signal(&b"invalid json"[..]).is_none());
+        assert!(read_signal(&b"[]"[..]).is_none());
+    }
+
+    #[test]
+    fn missing_sender_is_ignored() {
+        let missing = env::temp_dir().join(format!("t1-workstream-absent-{}", std::process::id()));
+        dispatch(&missing, &signal_for(&event("Stop")).unwrap());
+    }
+
+    #[test]
+    fn slow_sender_is_killed_and_reaped() {
+        let mut child = Command::new(env::current_exe().unwrap())
+            .args(["--exact", "tests::child_process_fixture", "--nocapture"])
+            .env("T1_WORKSTREAM_CLAUDE_TEST_SLOW_CHILD", "1")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        let started = Instant::now();
+        finish_child(&mut child, Duration::from_millis(30));
+        assert!(started.elapsed() < Duration::from_secs(2));
+        assert!(child.try_wait().unwrap().is_some());
+    }
+
+    #[test]
+    fn child_process_fixture() {
+        if env::var_os("T1_WORKSTREAM_CLAUDE_TEST_SLOW_CHILD").is_some() {
+            thread::sleep(Duration::from_secs(10));
+        }
+    }
+}
